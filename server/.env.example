# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Postgres connection string. Free options: Render, Railway, Supabase, Neon.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Filled in during later build steps, once each service is set up:
STRIPE_SECRET_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
